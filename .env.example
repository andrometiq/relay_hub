# ./relay install creates .env with a unique local service token.
# Existing environment variables take precedence. Values are literal, not shell code.
# Empty URL selects the checkout's private PostgreSQL database.
DATABASE_URL=
RELAY_ADDR=127.0.0.1:18081
RELAY_MCP_TOKEN=replace-with-at-least-32-random-characters
GOMAXPROCS=2
GOFLAGS=-p=2

# Port for the isolated local PostgreSQL cluster (ignored for external DATABASE_URL).
RELAY_PG_PORT=18432
# Optional private account registry (chmod 600), blank disables provider accounts.
RELAY_WHATSAPP_CONFIG=
# Docker database configuration. Set private passwords in .env before db-up.
RELAY_DATABASE_MODE=local
RELAY_DB_PORT=18433
POSTGRES_PASSWORD=replace-with-a-random-admin-password
CHANNEL_DB_PASSWORD=replace-with-your-database-password

# Adaptive delivery concurrency, bounded to 1–8 workers.
RELAY_OUTBOX_WORKERS=4

# Hub browser origin behind your HTTPS reverse proxy. Never derive this from request headers.
RELAY_PUBLIC_ORIGIN=https://relay.example.com
# Empty for a dedicated domain; /hub for the local review gateway.
RELAY_PUBLIC_PREFIX=
# RELAY_MCP_TOKEN is legacy development configuration; serve uses database-backed
# per-user API tokens exclusively. Bootstrap the first administrator via stdin.
# Required to encrypt channel credentials at rest; use a random private value.
RELAY_CREDENTIAL_KEY=
# Private random master (at least 32 characters) for per-account Telegram webhook
# secrets. Never send this master to Telegram. Hub admins retrieve each derived
# secret from GET /api/accounts/{account}/telegram/webhook for setWebhook.
RELAY_TELEGRAM_WEBHOOK_SECRET=
